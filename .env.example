# Copy to .env.local. Never commit real values.

# Absolute URL of the main site, used by the "Part of APMF" link on the
# subsidiary sites. In local development set this to http://localhost:3000.
NEXT_PUBLIC_FOUNDATION_URL="https://assoutudeen.com"

# --- Payload CMS -----------------------------------------------------------
# Neon Postgres. Use the POOLED connection string on Vercel.
DATABASE_URI="postgres://user:password@host.neon.tech/assoutudeen?sslmode=require"
# Long random string. `openssl rand -base64 32`
PAYLOAD_SECRET=""

# --- Cloudinary ------------------------------------------------------------
# Leave blank to keep uploads on local disk while developing; the Cloudinary
# storage plugin only mounts when all three are set.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="assoutudeen"

# Added in later sessions:
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
# RESEND_API_KEY=
