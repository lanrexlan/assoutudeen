# Copy to .env.local. Never commit real values.

# Absolute URL of the main site, used by the "Part of APMF" link on the
# subsidiary sites. In local development set this to http://localhost:3000.
NEXT_PUBLIC_FOUNDATION_URL="https://assoutudeen.com"

# --- Payload CMS -----------------------------------------------------------
# Neon Postgres. Use the POOLED connection string on Vercel.
#
# NEVER point `npm run dev` at the production database. In development Payload
# pushes schema changes straight to whatever database it finds and records a
# "dev" row in payload_migrations. Once that row exists, `payload migrate` — the
# first step of every deployment build — stops and asks whether to proceed,
# which nothing can answer on a build server. Use a local Postgres or a Neon
# branch for development.
DATABASE_URI="postgres://user:password@host.neon.tech/assoutudeen?sslmode=require"
# Long random string. `openssl rand -base64 32`
PAYLOAD_SECRET=""

# --- Cloudinary ------------------------------------------------------------
# Leave blank to keep uploads on local disk while developing; the Cloudinary
# storage plugin only mounts when all three are set.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="assoutudeen"

# --- Email (Resend) --------------------------------------------------------
# Without a key the forms still work and still store every submission; they
# simply do not notify anyone by email. Set these and the contact form starts
# delivering to the inbox for its topic.
#
# RESEND_FROM must be on a domain verified in the Resend dashboard. A plain
# gmail.com address will be rejected — DNS records have to be added for
# assoutudeen.com first.
RESEND_API_KEY=""
RESEND_FROM="Assoutudeen <noreply@assoutudeen.com>"
# Where anything without a topic-specific inbox goes, and where the assistance
# alert goes.
NOTIFY_EMAIL="info@assoutudeen.com"

# Added in later sessions:
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
